<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Oldest WPF-capable target the code supports, so .NET 6/7/8/9 apps can all consume the
         package. Raising this would drop consumers; net6.0 is the floor because System.Text.Json
         nodes (JsonNode/JsonObject) arrived in .NET 6. -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <!-- Newer language features are compiler-side and safe on an older target framework. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- net6.0 is out of support; this package still targets it deliberately for reach. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Ship XML docs for IntelliSense, without requiring a comment on every public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata. This project is the whole package: it carries the runtime
       library, the attributes, and (see below) the source generator. -->
  <PropertyGroup>
    <PackageId>WpfMcp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Gabriel Dickert</Authors>
    <Description>
      Turn a WPF application into an MCP server. Mark a class [McpToolCollection] and its methods
      [McpTool], and a source generator exposes them as Model Context Protocol tools over HTTP —
      including tools bound to live windows, async tools, progress reporting and cancellation.
    </Description>
    <PackageTags>mcp;model-context-protocol;wpf;source-generator;ai;llm</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/gabrieldickert/wpfmcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gabrieldickert/wpfmcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Release plumbing: a .snupkg of symbols plus SourceLink, so anyone consuming the package can
       step into this library's source under the debugger. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Set by CI (e.g. -p:ContinuousIntegrationBuild=true) for a deterministic, path-independent
         build. Left off locally because it rewrites paths the local debugger relies on. -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Referenced as an analyzer so tools in this project would be generated too, and so the
       generator is built before we pack it. ReferenceOutputAssembly=false keeps the generator
       out of the runtime closure. -->
  <ItemGroup>
    <ProjectReference Include="..\WpfMcp.Generators\WpfMcp.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the generator inside this package under analyzers/dotnet/cs, which is where the
       SDK looks for source generators. It must NOT go into lib/. -->
  <Target Name="PackGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\WpfMcp.Generators\WpfMcp.Generators.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="GeneratorAssembly" />
    </MSBuild>

    <ItemGroup>
      <None Include="@(GeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
