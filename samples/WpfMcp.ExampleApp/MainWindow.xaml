<Window
    x:Class="WpfMcp.ExampleApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfMcp.ExampleApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WpfMcp — MCP Server Host"
    Width="1100"
    Height="720"
    Background="#15181D"
    TextOptions.TextFormattingMode="Display"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <local:InverseBoolConverter x:Key="NotBool" />

        <SolidColorBrush x:Key="Surface" Color="#1D2129" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#232833" />
        <SolidColorBrush x:Key="Line" Color="#2E3440" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E7EBF2" />
        <SolidColorBrush x:Key="TextMuted" Color="#8A94A6" />
        <SolidColorBrush x:Key="Accent" Color="#5B9DF9" />
        <SolidColorBrush x:Key="Success" Color="#4ADE80" />
        <SolidColorBrush x:Key="Danger" Color="#F87171" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!--  One tool call in the activity feed.  -->
        <DataTemplate x:Key="ActivityTemplate">
            <Border
                Margin="0,0,0,8"
                Padding="14,12"
                Background="{StaticResource SurfaceAlt}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="BorderBrush" Value="#5A2A2A" />
                                <Setter Property="Background" Value="#2A1F22" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!--  Header: tool name, timestamp, duration  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,9,0"
                            VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock
                            Grid.Column="1"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Style="{StaticResource Mono}"
                            Text="{Binding ToolName}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                FontSize="11"
                                Foreground="{StaticResource TextMuted}"
                                Text="{Binding Duration}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextMuted}"
                                Text="{Binding StartedAt}" />
                        </StackPanel>
                    </Grid>

                    <!--  Arguments  -->
                    <TextBlock
                        Margin="16,6,0,0"
                        FontSize="12"
                        Foreground="{StaticResource TextMuted}"
                        Style="{StaticResource Mono}"
                        Text="{Binding Arguments}"
                        TextWrapping="Wrap" />

                    <!--  Progress, while the tool is running  -->
                    <StackPanel Margin="16,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <ProgressBar
                            Height="4"
                            Background="#161A21"
                            BorderThickness="0"
                            Foreground="{StaticResource Accent}"
                            IsIndeterminate="{Binding HasDeterminateProgress, Converter={StaticResource NotBool}}"
                            Maximum="{Binding ProgressMaximum}"
                            Value="{Binding Progress}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Foreground="{StaticResource Accent}"
                            Text="{Binding ProgressMessage}" />
                    </StackPanel>

                    <!--  Result  -->
                    <Border
                        Margin="16,10,0,0"
                        Padding="10,7"
                        Background="#161A21"
                        CornerRadius="5"
                        Visibility="{Binding IsRunning, Converter={StaticResource NotBoolToVis}}">
                        <TextBlock
                            FontSize="12"
                            Text="{Binding Result}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource Mono}" TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <Border
            Padding="18,14"
            Margin="0,0,0,14"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="MCP Server Host" />
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource Success}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextMuted}"
                            Style="{StaticResource Mono}"
                            Text="{Binding EndpointUrl}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,26,0" HorizontalAlignment="Right">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="21"
                            Foreground="{StaticResource TextPrimary}"
                            Text="{Binding CallCount}" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource TextMuted}"
                            Text="TOOL CALLS" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="21"
                            Foreground="{StaticResource Danger}"
                            Text="{Binding ErrorCount}" />
                        <TextBlock
                            FontSize="10"
                            Foreground="{StaticResource TextMuted}"
                            Text="ERRORS" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  Activity feed  -->
            <Border Padding="16,14" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="TOOL ACTIVITY" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource TextMuted}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasActivity, Converter={StaticResource NotBoolToVis}}">
                        <Run Text="No tool calls yet." />
                        <LineBreak />
                        <Run FontSize="11" Text="Connect an MCP client, or POST a tools/call to the endpoint above." />
                    </TextBlock>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <!--  Right margin keeps cards clear of the scrollbar.  -->
                        <ItemsControl
                            Margin="0,0,10,0"
                            ItemTemplate="{StaticResource ActivityTemplate}"
                            ItemsSource="{Binding Activities}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  Application state driven by tools  -->
            <Border
                Grid.Column="2"
                Padding="16,14"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="WINDOW STATE" />

                    <Border
                        Grid.Row="1"
                        Padding="13,11"
                        Margin="0,0,0,16"
                        Background="{StaticResource SurfaceAlt}"
                        CornerRadius="7">
                        <StackPanel>
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource TextMuted}"
                                Text="STATUS" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="14"
                                Foreground="{StaticResource TextPrimary}"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  A real editable control. Two-way bound, so an MCP tool can write into it
                          and read back whatever the user typed.  -->
                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource SectionHeader}"
                        Text="EDITOR — TYPE HERE, OR LET THE MODEL" />

                    <Border
                        Grid.Row="3"
                        Margin="0,0,0,16"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        CornerRadius="7">
                        <TextBox
                            Padding="11,9"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{StaticResource Accent}"
                            FontFamily="Cascadia Mono, Consolas, Courier New"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimary}"
                            SelectionBrush="{StaticResource Accent}"
                            Text="{Binding DocumentText, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>

                    <TextBlock
                        Grid.Row="4"
                        Style="{StaticResource SectionHeader}"
                        Text="NOTES" />

                    <Grid Grid.Row="5">
                        <TextBlock
                            Foreground="{StaticResource TextMuted}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasNotes, Converter={StaticResource NotBoolToVis}}"
                            Text="Empty. Call add_note to put something here." />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="11,8"
                                            Background="{StaticResource SurfaceAlt}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource TextPrimary}"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
