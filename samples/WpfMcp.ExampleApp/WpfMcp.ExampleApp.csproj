<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Write generator output to obj/GeneratedFiles so it can be inspected/debugged. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- Mirrors what the NuGet package gives a consumer: the runtime library plus the generator
       as an analyzer. A package consumer gets both from a single PackageReference. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\WpfMcp.Core\WpfMcp.Core.csproj" />
    <ProjectReference Include="..\..\src\WpfMcp.Generators\WpfMcp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
